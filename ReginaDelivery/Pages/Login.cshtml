@page "/login"
@model ReginaDelivery.Pages.LoginModel
@{
    ViewData["Title"] = Strings.Login;
    ViewData["BodyClass"] = "login-page";
}
<main class="login-wrap">
    <div class="login-card card">
        <div class="login-brand">
            <div class="login-logo" aria-hidden="true">RC</div>
            <partial name="_Wordmark" />
            <p class="muted">@Strings.LoginSubtitle</p>
        </div>
        @if (Model.Error is not null)
        {
            <div class="alert alert-err" role="alert">@Model.Error</div>
        }
        <form method="post" class="stack">
            <input type="hidden" asp-for="ReturnUrl" />
            <label class="field">
                <span>@Strings.Username</span>
                <input asp-for="Username" autocomplete="username" autocapitalize="none" autocorrect="off" spellcheck="false" required autofocus />
            </label>
            <label class="field">
                <span>@Strings.Password</span>
                <input asp-for="Password" type="password" autocomplete="current-password" required />
            </label>
            <button type="submit" class="btn btn-primary btn-block btn-lg">@Strings.Login</button>
        </form>
    </div>
</main>
