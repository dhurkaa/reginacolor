@{
    Layout = "_Layout";
    ViewData["BodyClass"] = "field";
    var path = (Context.Request.Path.Value ?? "").ToLowerInvariant().TrimEnd('/');
}
<header class="field-bar">
    <a class="wordmark" href="/field"><partial name="_Wordmark" /></a>
    <nav class="field-nav">
        <a href="/field/history" class="@(path == "/field/history" ? "active" : "")">@Strings.History</a>
        <form asp-page="/Logout" method="post">
            <button type="submit" class="btn btn-ghost btn-sm">@Strings.Logout</button>
        </form>
    </nav>
</header>
<main class="field-main">
    @RenderBody()
</main>
@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
